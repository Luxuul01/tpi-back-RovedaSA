# Variables de entorno del docker compose. Todas son opcionales: si no se definen, se usan los valores de demo
# que figuran acá (los mismos que tiene docker-compose.yml como default), así `docker compose up -d --build`
# funciona sin configurar nada. Para cambiarlas: copiar este archivo a .env (docker compose lo lee solo) y editar.
# El archivo .env está en .gitignore: no se sube al repositorio.

# ---------------------------------------------------------------------------------------------------------------
# Secretos
# ---------------------------------------------------------------------------------------------------------------
# Contraseñas de las bases (usuario postgres). Postgres solo las toma al crear el volumen: si ya existe, para
# cambiarlas hay que recrearlo (docker compose down -v).
CATALOGO_DB_PASSWORD=postgrespassword
CONTRATOS_DB_PASSWORD=postgrespassword

# Secreto del cliente confidencial backend-services de Keycloak (cuenta de servicio con la que ms-contratos llama
# al catálogo). Keycloak lo carga en el realm al importarlo y ms-contratos lo usa para pedir el token.
# Keycloak no guarda el realm entre reinicios del contenedor, así que el cambio se aplica al recrearlo.
KEYCLOAK_CLIENT_SECRET=backend-secret-rovedasa-2026

# Administrador de la consola de Keycloak (http://localhost:8083/admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Administrador de Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------------------------------------------
# Puertos publicados en el host (cambiarlos si alguno ya está ocupado, por ejemplo por un Postgres local en 5432).
# Dentro de la red de Docker los servicios siguen usando los puertos internos de siempre.
# ---------------------------------------------------------------------------------------------------------------
GATEWAY_PORT=8080
CATALOGO_PORT=8081
CONTRATOS_PORT=8082
KEYCLOAK_PORT=8083
DB_CATALOGO_PORT=5432
DB_CONTRATOS_PORT=5433
GRAFANA_PORT=3000
LOKI_PORT=3100

# ---------------------------------------------------------------------------------------------------------------
# Perfil de Spring de ms-catalogo-inmobiliario y ms-contratos: docker (por defecto) o docker,demo (BCRA y GeoRef
# simulados; ver README, sección del perfil demo).
# ---------------------------------------------------------------------------------------------------------------
PERFIL_SERVICIOS=docker
