<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 1. Variables de configuración -->
    <property name="LOGS_DIR" value="./logs" />
    <property name="LOG_FILE_NAME" value="catalogo-service" />

    <!-- 2. Formato de las líneas de log -->
    <!-- Patrón con colores para la consola -->
    <property name="CONSOLE_LOG_PATTERN"
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{correlationId}] %cyan(%logger{36}) - %msg%n" />

    <!-- Patrón limpio para el archivo en disco (sin caracteres ANSI de color) -->
    <property name="FILE_LOG_PATTERN"
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{correlationId}] %logger{36} - %msg%n" />

    <!-- 3. Appender: Salida por Consola -->
    <appender name="Consola" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 4. Appender: Salida a Archivo Rotativo en Disco -->
    <appender name="ArchivoRotativo" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/${LOG_FILE_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Nombre del archivo comprimido al rotar (por día e índice) -->
            <fileNamePattern>${LOGS_DIR}/archived/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Tamaño máximo antes de rotar -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Cuántos días conservar el historial -->
            <maxHistory>30</maxHistory>
            <!-- Tamaño total máximo acumulado en disco -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Appender exclusivo para Errores Críticos -->
    <appender name="ArchivoErrores" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 1. El filtro que frena todo lo que no sea ERROR -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>

        <!-- 2. Ruta fija al archivo de errores -->
        <file>${LOGS_DIR}/${LOG_FILE_NAME}-error.log</file>

        <!-- 3. Política de rotación para que tampoco crezca infinito -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOGS_DIR}/archived/${LOG_FILE_NAME}-error.log-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>


    <!-- 5. Niveles de log -->
    <!-- Nuestro paquete de negocio en DEBUG para ver detalles -->
    <logger name="com.rovedasa" level="DEBUG" additivity="false">
        <appender-ref ref="Consola" />
        <appender-ref ref="ArchivoRotativo" />
        <appender-ref ref="ArchivoErrores" />
    </logger>

    <!-- El resto de las librerías en INFO para evitar ruido -->
    <root level="INFO">
        <appender-ref ref="Consola" />
        <appender-ref ref="ArchivoRotativo" />
        <appender-ref ref="ArchivoErrores" />
    </root>

</configuration>