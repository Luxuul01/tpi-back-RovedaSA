      "name": "1 - Flujo central (catálogo + BCRA)",
      "description": "Recorrido de punta a punta disponible hoy. Cuando Dev 3 publique ms-contratos, los pasos 6 y 7 los dispara POST /api/contratos/{id}/seniar y /activar en lugar del PATCH directo.",
      "item": [
        {
          "name": "1. Crear propietario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera un CUIT/CUIL válido (módulo 11) para que la colección se pueda correr varias veces",
                  "function generarCuit(prefijo) {",
                  "  const pesos = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2];",
                  "  while (true) {",
                  "    const base = prefijo + String(Math.floor(10000000 + Math.random() * 89999999));",
                  "    let suma = 0;",
                  "    for (let i = 0; i < 10; i++) suma += parseInt(base[i]) * pesos[i];",
                  "    let dv = 11 - (suma % 11);",
                  "    if (dv === 11) dv = 0;",
                  "    if (dv === 10) continue;",
                  "    return base + dv;",
                  "  }",
                  "}",
                  "pm.collectionVariables.set('cuitPropietario', generarCuit('20'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('propietarioId', b.id);",
                  "pm.test('Devuelve el id', () => pm.expect(b.id).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/personas",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuitCuil\": \"{{cuitPropietario}}\",\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"roles\": [\n    \"PROPIETARIO\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
